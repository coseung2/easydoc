EXPO_PUBLIC_RELAY_URL=https://easydoc-relay.example.workers.dev
# Scanbot trial/production license. Empty enables only the SDK's 60-second evaluation session.
EXPO_PUBLIC_SCANBOT_LICENSE_KEY=
# Keep `js` as the production default. Use `opencv` only for native benchmark builds.
EXPO_PUBLIC_SCAN_IMAGE_BACKEND=js
# Keep `legacy` as the production default until page-level device benchmarks pass.
EXPO_PUBLIC_PDF_RASTERIZER_BACKEND=legacy
