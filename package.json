{
  "name": "easydoc",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "patch-package",
    "test": "node --test packages/protocol/test/*.test.ts packages/crypto/test/*.test.ts packages/pdf-tools/test/*.test.ts packages/image-processing/test/*.test.ts apps/relay/test/*.test.ts apps/desktop/test/*.test.ts apps/mobile/test/*.test.ts test/*.test.ts",
    "test:protocol": "node --test packages/protocol/test/*.test.ts",
    "test:relay": "node --test apps/relay/test/*.test.ts",
    "test:desktop": "node --test apps/desktop/test/*.test.ts",
    "test:mobile": "node --test apps/mobile/test/*.test.ts",
    "test:integration": "node --test test/*.test.ts",
    "milestone0:file": "node scripts/milestone0-file-transfer.ts",
    "test:crypto": "node --test packages/crypto/test/*.test.ts",
    "test:pdf-tools": "node --test packages/pdf-tools/test/*.test.ts",
    "test:image-processing": "node --test packages/image-processing/test/*.test.ts",
    "typecheck:mobile": "tsc -p apps/mobile/tsconfig.json --noEmit",
    "typecheck:relay": "tsc -p apps/relay/tsconfig.json --noEmit",
    "build:desktop-ui": "npm --workspace @easydoc/desktop run build:vite",
    "check:relay": "wrangler deploy --dry-run --config apps/relay/wrangler.toml",
    "verify": "npm test && npm run typecheck:mobile && npm run typecheck:relay && npm run build:desktop-ui && npm run check:relay"
  },
  "devDependencies": {
    "patch-package": "^8.0.1"
  }
}
